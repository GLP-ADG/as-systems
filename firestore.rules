rules_version = '2';
// Reglas de seguridad de AS SYSTEMS (Araucana de Gases)
// - Solo usuarios registrados en /usuarios y activos pueden ver la información.
// - Administrador (uno solo): todo. Es el ÚNICO que agrega, edita o elimina técnicos y usuarios,
//   y el único que borra productos, celulares, préstamos o movimientos.
// - Bodega: registra entradas, salidas, préstamos, devoluciones y celulares.
// - Consulta: solo ve.
// - Arranque: mientras no exista config/general, la primera persona que entre se declara administradora.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function activo() { return signed() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && perfil().get('activo', true) == true; }
    function admin() { return activo() && perfil().rol == 'admin'; }
    function operador() { return activo() && perfil().rol in ['admin', 'bodega']; }
    function sinConfig() { return !exists(/databases/$(database)/documents/config/general); }

    match /usuarios/{uid} {
      allow read: if signed() && (request.auth.uid == uid || admin());
      // Nadie más puede quedar como administrador
      allow create: if (admin() && request.resource.data.rol in ['bodega', 'consulta'])
                    || (signed() && request.auth.uid == uid && sinConfig() && request.resource.data.rol == 'admin');
      allow update: if admin() && (request.resource.data.rol in ['bodega', 'consulta']
                    || (request.auth.uid == uid && request.resource.data.rol == 'admin'));
      allow delete: if admin() && request.auth.uid != uid;
    }
    match /config/publico {
      allow read: if true;
      allow write: if admin();
    }
    match /config/{id} {
      allow read: if activo();
      allow write: if admin();
    }
    match /tecnicos/{id} {
      allow read: if activo();
      allow write: if admin();
    }
    match /productos/{id} {
      allow read: if activo();
      allow create, update: if operador();
      allow delete: if admin();
    }
    match /movimientos/{id} {
      allow read: if activo();
      allow create: if operador() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if admin();
    }
    match /prestamos/{id} {
      allow read: if activo();
      allow create, update: if operador();
      allow delete: if admin();
    }
    // Aplicativo madre: catálogo de aplicativos y licencias de clientes
    match /aplicativos/{id} {
      allow read, write: if admin();
    }
    match /licencias/{codigo} {
      // Cualquier aplicativo puede consultar SU licencia conociendo el código; solo el administrador las lista o modifica
      allow get: if true;
      allow list, write: if admin();
    }
    match /celulares/{id} {
      allow read: if activo();
      allow create, update: if operador();
      allow delete: if admin();
    }
  }
}
